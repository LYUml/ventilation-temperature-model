    bes:stationId "545110" .

<OFF_OccHeat_Weekly> a bes:WeeklySchedule ;
    bes:fridaySchedule <OFF_OccHeat_AllDay> ;
    bes:mondaySchedule <OFF_OccHeat_AllDay> ;
    bes:saturdaySchedule <OFF_OccHeat_AllDay> ;
    bes:scheduleName "OFF_OccHeat_Weekly" ;
    bes:sundaySchedule <OFF_OccHeat_AllDay> ;
    bes:thursdaySchedule <OFF_OccHeat_AllDay> ;
    bes:tuesdaySchedule <OFF_OccHeat_AllDay> ;
    bes:wednesdaySchedule <OFF_OccHeat_AllDay> .

bes:AirWall a bes:GbxmlSurfaceType .

bes:EmbeddedColumn a bes:GbxmlSurfaceType .

bes:FreestandingColumn a bes:GbxmlSurfaceType .

bes:RaisedFloor a bes:GbxmlSurfaceType .

bes:Shade a bes:GbxmlSurfaceType .

bes:UndergroundWall a bes:GbxmlSurfaceType .

bes:fridaySchedule a rdf:Property .

bes:hasSurfaceType rdfs:range moosas:surfaceType .

bes:hourlyValuesJson a rdf:Property .

bes:mondaySchedule a rdf:Property .

bes:saturdaySchedule a rdf:Property .

bes:scheduleName a rdf:Property .

bes:sundaySchedule a rdf:Property .

bes:surfaceType a rdf:Property .

bes:thursdaySchedule a rdf:Property .

bes:timeStepHours a rdf:Property .

bes:tuesdaySchedule a rdf:Property .

bes:valueCount a rdf:Property .

bes:valueMode a rdf:Property .

bes:valueUnit a rdf:Property .

bes:wednesdaySchedule a rdf:Property .

geo:hasGeometry rdfs:subPropertyOf moosas:Geometry .

moosas:AirWall a moosas:surfaceType ;
    rdfs:comment "air boundary Element the dot value with (0,0,1) bigger than 0.8660254037844387" .

moosas:Category rdfs:subPropertyOf moosas:Geometry .

moosas:Offset rdfs:subPropertyOf bot:Element .

moosas:SHGC rdfs:subPropertyOf bot:Element .

moosas:TopoElement rdfs:comment "1LSB element of the space which used to show the topology" ;
    rdfs:subClassOf bot:Element .

moosas:U_Value rdfs:subPropertyOf bot:Element .

moosas:Uid rdfs:subPropertyOf bot:Element,
        bot:Space .

moosas:altitute rdfs:subPropertyOf bot:Storey .

moosas:climate_zone a moosas:ZoneInfo ;
    rdfs:subPropertyOf moosas:Program ;
    moosas:Uid "climate_zone" .

